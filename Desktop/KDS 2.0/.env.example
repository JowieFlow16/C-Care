# GitHub integration
GITHUB_TOKEN=ghp_xxx-your-token-here
GITHUB_REPO_OWNER=your-github-username
GITHUB_REPO_NAME=your-repo-name
GITHUB_DATA_PATH=data
GITHUB_BRANCH=main

# Optional tuning
GITHUB_MAX_RETRIES=4
GITHUB_RETRY_DELAY_MS=300

# Committer info (optional)
GITHUB_COMMITTER_NAME=Your Name
GITHUB_COMMITTER_EMAIL=you@example.com
